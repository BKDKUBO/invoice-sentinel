# Gemini (Google AI Studio) — required for live multimodal analysis.
# Without this key, the API runs in demo/mock mode using seed heuristics.
GEMINI_API_KEY=

# Optional: override model (defaults to gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# API
API_HOST=0.0.0.0
API_PORT=8080
DATA_DIR=../data
UPLOAD_DIR=../data/uploads
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Web (Next.js) — point at local API or Cloud Run URL
NEXT_PUBLIC_API_URL=http://localhost:8080
